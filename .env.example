# Copy to `.env` in this directory and fill in values.
# `OPENAI_BASE_URL` is optional; default OpenAI API is used if empty.
# Compatible providers: OpenAI, Azure OpenAI (resource URL), LiteLLM proxy, vLLM OpenAI server, etc.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=llama-3.1-8b-instruct

# Optional: path to a Microban .txt file (overrides default / bundled levels)
# TRACK1_LEVELS_PATH=data/microban.txt

# Optional: comma-separated origins for the Vue dev server (defaults include localhost:5173)
# TRACK1_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
